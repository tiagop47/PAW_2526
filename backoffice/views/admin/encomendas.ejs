<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">
    <%- include('../partials/navbar') %>

    <%
    const labelEstado = {
        pendente: 'Pendente',
        confirmada: 'Confirmada',
        preparacao: 'Em Preparação',
        em_entrega: 'Em Entrega',
        aguarda_confirmacao: 'Aguarda Confirmação',
        entregue: 'Entregue',
        cancelada: 'Cancelada'
    };
    %>

        <main class="container py-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 fw-bold m-0 text-dark">Monitorização de Encomendas</h1>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID / Data</th>
                                <th>Supermercado</th>
                                <th>Cliente</th>
                                <th>Total</th>
                                <th>Estado</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (encomendas && encomendas.length > 0) { %>
                                <% encomendas.forEach(function(e) { %>
                                    <tr>
                                        <td>
                                            <div class="small fw-bold text-muted">#<%=
                                                    e._id.toString().slice(-6).toUpperCase() %>
                                            </div>
                                            <div class="small text-muted">
                                                <%= new Date(e.criadoEm).toLocaleString('pt-PT') %>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-bold">
                                                <%= e.supermercadoId ? e.supermercadoId.nome : 'N/A' %>
                                            </span>
                                        </td>
                                        <td>
                                            <div>
                                                <%= e.clienteId ? e.clienteId.nome : 'N/A' %>
                                            </div>
                                            <div class="small text-muted">
                                                <%= e.clienteId ? e.clienteId.email : '' %>
                                            </div>
                                        </td>
                                        <td class="fw-bold">
                                            <%= e.valorTotal.toFixed(2) %>€
                                        </td>
                                        <td>
                                            <span class="badge bg-dark">
                                                <%= labelEstado[e.estado] || e.estado %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (e.faturaNumero) { %>
                                                <a href="/admin/encomendas/<%= e._id %>/fatura"
                                                   class="btn btn-sm btn-outline-dark">Fatura</a>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                            <tr>
                                                <td colspan="6" class="text-center py-4 text-muted">Não foram
                                                    encontradas encomendas no sistema.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <%- include('../partials/paginacao', { paginaUrl: '/admin/encomendas' }) %>
        </main>
</body>

</html>
<header class="cabecalho-principal border-bottom border-dark bg-white">
    <div class="container d-flex align-items-center justify-content-between py-2">
        <!-- Logotipo Dinâmico -->
        <% 
            let dashboardLink = "/";
            if (user) {
                if (user.role === 'supermercados') dashboardLink = "/supermercado/dashboard";
                else if (user.role === 'estafetas') dashboardLink = "/estafeta/dashboard";
                else if (user.role === 'administrador') dashboardLink = "/admin/dashboard";
                else if (user.role === 'clientes') dashboardLink = "/cliente/dashboard";
            }
        %>
        <a href="<%= dashboardLink %>" class="btn btn-sm btn-light border border-dark text-dark fw-bold px-3">
            Página Principal
        </a>
        <% if (user) { %>
            <p class="text-dark small mb-0">Utilizador: <%= user.nome %>
            </p>
            <% } %>

                <nav class="navegacao-links d-none d-lg-flex align-items-center gap-4">
                    <% if (user) { %>
                        <% if (user.role==='supermercados' ) { %>
                            <a href="/supermercado/reclamacoes" class="text-dark small fw-bold text-decoration-none">Reclamações</a>
                        <% } else if (user.role==='administrador') { %>
                            <a href="/admin/reclamacoes" class="text-dark small fw-bold text-decoration-none">Reclamações</a>
                        <% } %>
                    <% } %>
                </nav>

                <div class="area-utilizador d-flex align-items-center gap-2">
                    <% if (user) { %>
                        <a href="/auth/logout" class="btn btn-dark btn-sm px-3">Fechar Painel</a>
                        <% } else { %>
                            <a href="/auth/login" class="btn btn-dark btn-sm px-4">Entrar</a>
                            <% } %>
                </div>
    </div>
</header>

<!-- Container para Notificações (Toasts) -->
<div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;"></div>

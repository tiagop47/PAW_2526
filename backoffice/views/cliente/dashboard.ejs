<!DOCTYPE html>
<html lang="pt">
<head>
    <%- include('../partials/head', { title: 'Dashboard Cliente' }) %>
</head>
<body class="bg-light">
    <%- include('../partials/navbar') %>

    <main class="container py-4">
        <header class="mb-4">
            <h1 class="h4 fw-bold">Bem-vindo, <%= user.nome %></h1>
            <p class="text-muted">Explore produtos nos supermercados próximos.</p>
        </header>

        <!-- Filtros de Pesquisa -->
        <div class="card border-0 shadow-sm p-3 mb-4">
            <div class="row g-2">
                <div class="col-md-8">
                    <input type="text" id="pesquisaNome" data-produto-pesquisa="input" class="form-control" placeholder="O que procura hoje?">
                </div>
                <div class="col-md-4">
                    <select id="pesquisaCategoria" data-produto-pesquisa="categoria" class="form-select">
                        <option value="">Todas as categorias</option>
                        <% categorias.forEach(function(cat) { %>
                            <option value="<%= cat._id %>"><%= cat.nome %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
        </div>

        <!-- Resultados -->
        <div class="row g-4" id="resultadosProdutos">
            <div class="col-12 text-center py-5 text-muted">
                <p>Use a barra de pesquisa para encontrar produtos.</p>
            </div>
        </div>
    </main>

    <!-- Script de Pesquisa (Adaptado para o Cliente) -->
    <script>
        // O cliente precisa de uma API que pesquise em TODOS os supermercados
        // Por agora, vamos usar a API existente mas adaptada se necessário
    </script>
</body>
</html>

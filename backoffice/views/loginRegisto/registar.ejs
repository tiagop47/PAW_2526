<!DOCTYPE html>
<html lang="pt">
<head>
    <%- include('../partials/head') %>
    
    <% if (!locals.dados?.onlyUser) { %>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <% } %>
</head>
<body class="bg-light">

    <main class="auth-container d-flex align-items-center justify-content-center py-5">
        <div class="card shadow border-0 p-4" style="max-width: 600px; width: 100%; border-radius: 10px;">
            <header class="text-center mb-4">
                <h2 class="h4 fw-bold text-primary m-0">
                    <%= locals.dados?.onlyUser ? 'Novo Gestor' : 'Registo de Parceiro' %>
                </h2>
                <p class="text-muted small">
                    <%= locals.dados?.onlyUser ? 'Crie a conta do novo gestor para este supermercado' : 'Crie a sua conta de Supermercado ou Estafeta' %>
                </p>
            </header>

            <% if (locals.errorMessage) { %>
                <div class="alert alert-danger small"><%= errorMessage %></div>
            <% } %>

            <form action="/auth/registar" method="POST">
                <% if (locals.dados?.onlyUser) { %>
                    <input type="hidden" name="onlyUser" value="true">
                    <input type="hidden" name="supermarketId" value="<%= locals.dados.supermarketId %>">
                    <input type="hidden" name="role" value="supermercados">
                <% } %>
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Nome Completo</label>
                        <input type="text" id="nome" name="nome" class="form-control" value="<%= locals.dados?.nome || '' %>" minlength="3" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Email</label>
                        <input type="email" id="email" name="email" class="form-control" value="<%= locals.dados?.email || '' %>" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Password</label>
                        <input type="password" name="password" id="password" class="form-control" required>
                    </div>
                    <div class="col-md-6">
                       <label class="form-label small fw-bold">NIF (Opcional)</label>
                       <input type="number" name="nif" id="nif" class="form-control" value="<%= locals.dados?.nif || '' %>" minlength="9" maxlength="9">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Telemóvel</label>
                        <input type="number" id="telefone" name="telefone" class="form-control" value="<%= locals.dados?.telefone || '' %>" minlength="9" maxlength="9" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Morada Completa</label>
                        <input type="text" name="morada" class="form-control" value="<%= locals.dados?.morada || '' %>" minlength="5" placeholder="Ex: Rua Direita, nº 123" required>
                    </div>

                    <% if (!locals.dados?.onlyUser) { %>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Tipo de Perfil</label>
                            <select name="role" id="seletor-role" class="form-select" required>
                                <option value="supermercados" selected>Supermercado</option>
                                <option value="estafetas">Estafeta</option>
                            </select>
                        </div>

                        <!-- Campos Específicos para Supermercado -->
                        <div id="campos-supermercado" class="row g-3 m-0 pt-3 border-top mt-3">
                            <div class="col-12">
                                <label class="form-label small fw-bold">Concelho (Zona de Trabalho)</label>
                                <select name="localizacao" id="seletor-concelho" class="form-select">
                                    <option value="" disabled selected>Selecione o concelho...</option>
                                    <option value="Lousada">Lousada</option>
                                    <option value="Porto">Porto</option>
                                    <option value="Felgueiras">Felgueiras</option>
                                    <option value="Penafiel">Penafiel</option>
                                </select>
                            </div>

                            <div class="col-12 mt-3">
                                <label class="form-label small fw-bold">Localização Exata (Clique no Mapa)</label>
                                <div id="mapa-edicao" style="height: 250px; border-radius: 8px; border: 1px solid #dee2e6;"></div>
                                <div class="d-flex gap-2 mt-2">
                                    <div class="w-50">
                                        <label class="x-small text-muted">Latitude</label>
                                        <input type="text" id="input-lat" name="latitude" class="form-control form-control-sm" readonly required>
                                    </div>
                                    <div class="w-50">
                                        <label class="x-small text-muted">Longitude</label>
                                        <input type="text" id="input-lon" name="longitude" class="form-control form-control-sm" readonly required>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 mt-3">
                                <label class="form-label fw-bold small d-block">Métodos de Entrega</label>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="metodosEntrega" value="levantamento_loja" checked>
                                    <label class="form-check-label small">levantamento_loja</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="metodosEntrega" value="entrega_domicilio" checked>
                                    <label class="form-check-label small">entrega_domicilio</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Custo - Entrega ao Domicílio (€)</label>
                                <input type="number" step="0.01" name="custoEntregaPorMetodo[entrega_domicilio]" class="form-control" value="2.50" min="0">
                            </div>
                        </div>
                    <% } %>
                </div>

                <input type="hidden" id="g-recaptcha-response" name="g-recaptcha-response">
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mt-4">
                    <%= locals.dados?.onlyUser ? 'Criar e Associar Gestor' : 'Criar Conta' %>
                </button>
            </form>

            <footer class="mt-4 pt-3 border-top text-center">
                <p class="mb-0 small text-muted">
                    <% if (locals.dados?.onlyUser) { %>
                        <a href="/admin/supermercados/pendentes" class="text-decoration-none text-primary fw-bold">Cancelar e Voltar</a>
                    <% } else { %>
                        Já tem conta? <a href="/auth/login" class="fw-bold text-primary text-decoration-none">Inicie sessão</a>
                    <% } %>
                </p>
            </footer>
        </div>
    </main>

    <script src="/javascript/userValidator.js"></script>
    <script src="/javascript/auth/registoValidacao.js"></script>
    
    <% if (!locals.dados?.onlyUser) { %>
        <script src="https://www.google.com/recaptcha/api.js?render=<%= siteKey %>"></script>
        <script src="/javascript/auth/recaptcha.js"></script>
        <script src="/javascript/mapa.js"></script>
        <script src="/javascript/supermercado/supermercadoAcoes.js"></script>
    <% } %>
</body>
</html>
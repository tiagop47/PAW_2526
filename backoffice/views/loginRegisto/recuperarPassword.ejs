<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar Password - Minha App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css" />
</head>

<body>

    <main class="auth-container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
        <div class="card shadow border-0 p-4" style="max-width: 450px; width: 100%; border-radius: 20px;">
            <header class="text-center mb-4">
                <h2 class="fw-bold text-primary">Recuperar Password</h2>
                <p class="text-muted small">Insira o seu email para enviarmos instruções</p>
            </header>
            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <div class="alert alert-danger" role="alert">
                    <%= errorMessage %>
                </div>
            <% } %>
            <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                <div class="alert alert-success" role="alert">
                    <%= successMessage %>
                </div>
            <% } %>
            <form action="/auth/recuperarPassword" method="POST">
                <div class="form-floating mb-4">
                    <input type="email" class="form-control" id="email" name="email" placeholder="nome@exemplo.com"
                        required>
                    <label for="email">Endereço de Email</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Enviar Link</button>
            </form>

            <footer class="mt-4 pt-3 border-top text-center">
                <p class="mb-0">Voltar para o <a href="/auth/login" class="auth-footer-link">Login</a></p>
            </footer>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
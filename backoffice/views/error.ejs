<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('./partials/head', { title: 'Erro' }) %>
</head>

<body class="bg-light">
    <% const statusCode=(locals.error && locals.error.status) ? locals.error.status : 500; %>
        <% const tituloErroDefault=statusCode===404 ? 'Página não encontrada' : 'Algo correu mal' ; const
            detalheErroDefault=statusCode===404 ? 'A página que procuras não existe ou foi movida.' : (locals.message
            || 'Ocorreu um erro inesperado.' ); const tituloFinal=locals.tituloErro || tituloErroDefault; const
            detalheFinal=locals.detalheErro || detalheErroDefault; %>

            <div class="container mt-5">
                <div class="text-center mx-auto shadow-sm p-5 bg-white rounded"
                    style="max-width: 600px; border-top: 5px solid #dc3545;">
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h1 class="display-1 text-danger fw-bold mb-0">
                        <%= statusCode %>
                    </h1>
                    <h2 class="h4 mb-4 text-dark">
                        <%= tituloFinal %>
                    </h2>
                    <p class="text-muted mb-4 lead">
                        <%= detalheFinal %>
                    </p>

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a href="/" class="btn btn-primary px-4 gap-3">Voltar ao Início</a>
                    </div>
                </div>
            </div>

</body>

</html>
<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>

<body data-estafeta-id="<%= estafetaId || '' %>">
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Entregas Disponíveis</h4>
            </div>

            <div class="row">
                <div class="col-md-7">
                    <div id="lista-encomendas">
                        <% if (entregas && entregas.length> 0) { %>
                            <% entregas.forEach(entrega=> { %>
                                <div class="card mb-2 order-card" data-id="<%= entrega._id %>"
                                    data-zona="<%= ((entrega.supermercadoId && entrega.supermercadoId.localizacao) ? entrega.supermercadoId.localizacao : '').toLowerCase().trim() %>">
                                    <div class="card-body py-2">
                                        <p class="mb-1"><strong>Encomenda:</strong> #<%=
                                                entrega._id.toString().slice(-6).toUpperCase() %>
                                        </p>
                                        <p class="mb-1"><strong>Supermercado:</strong>
                                            <%= entrega.supermercadoId?.nome %>
                                        </p>
                                        <p class="mb-1"><strong>Destino:</strong>
                                            <%= entrega.moradaEntrega || (entrega.clienteId ? entrega.clienteId.morada
                                                : 'Morada não especificada' ) %>
                                        </p>
                                        <p class="mb-2"><strong>Total:</strong>
                                            <%= (entrega.valorTotal || 0).toFixed(2) %>€ | <strong>Taxa:</strong>
                                                <%= (entrega.supermercadoId?.custoEntregaPorMetodo?.[entrega.metodoEntrega] || 0).toFixed(2) %>€
                                        </p>

                                        <div class="d-flex gap-2">
                                            <% if (entrega.coordenadasEntrega &&
                                                Number.isFinite(entrega.coordenadasEntrega.lat) &&
                                                Number.isFinite(entrega.coordenadasEntrega.lng)) { %>
                                                <a href="#" class="btn btn-sm btn-outline-secondary link-focar-destino"
                                                    data-lat="<%= entrega.coordenadasEntrega.lat %>"
                                                    data-lng="<%= entrega.coordenadasEntrega.lng %>">Ver Destino</a>
                                                <% } %>
                                                    <button class="btn btn-sm btn-primary btn-aceitar-entrega"
                                                        data-id="<%= entrega._id %>">Aceitar</button>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                                <% } %>
                                </div>                </div>


                <div class="col-md-5">
                    <%- include('../partials/mapaComponent', { mapaId: 'mapa-entregas' , mapaAltura: '500px' ,
                        mapaTitulo: 'Visão Global de Entregas' , mapaAcoes: '' ,
                        mapaFooter: '<small class="text-muted">Use o filtro por zona para simplificar a visualização no mapa.</small>'
                        }) %>
                </div>
            </div>
        </div>

        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="/javascript/mapa.js"></script>
        <script src="/javascript/estafeta/estafetaAcoes.js"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">
    <%- include('../partials/navbar') %>

        <main class="container py-4">

            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">Entregas
                                Realizadas</small>
                            <div class="h3 mb-0 mt-1">
                                <%= stats.entregasRealizadas %>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">Em Curso</small>
                            <div class="h3 mb-0 mt-1">
                                <%= stats.entregasEmCurso %>
                            </div>
                        </div>
                    </div>
                </div>
              
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">Ganhos
                                Totais</small>
                            <div class="h3 mb-0 mt-1">
                                <%= Number(stats.ganhosTotais || 0).toFixed(2) %>&euro;
                            </div>
                        </div>
                    </div>
                </div>
                <% if (stats.zonaMaisPopular) { %>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">Zona + Popular</small>
                                <div class="h3 mb-0 mt-1">
                                    <%= stats.zonaMaisPopular %>
                                </div>
                                <small class="text-muted" style="font-size: 0.7rem;">
                                    <%= stats.totalZonaPopular %> <%= stats.totalZonaPopular === 1 ? 'encomenda' : 'encomendas' %> disponíveis
                                </small>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>

            <div id="chart-data" data-evolucao-mensal="<%= JSON.stringify(stats.evolucaoMensal || []) %>"
                style="display: none;"></div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h6 text-muted fw-bold text-uppercase mb-3">Ações rápidas</h2>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label for="zonaTrabalhoDashboard" class="form-label small fw-bold mb-1">Zona de
                                Trabalho</label>
                            <select id="zonaTrabalhoDashboard" class="form-select form-select-sm"
                                data-estafeta-id="<%= estafetaId || '' %>">
                                <option value="">Selecione a zona</option>
                                <% (zonasTrabalho || []).forEach((zona)=> { %>
                                    <option value="<%= zona.value %>">
                                        <%= zona.label %>
                                    </option>
                                    <% }); %>
                            </select>
                            <small class="text-muted d-block mt-1">Define a zona antes de abrir as encomendas.</small>
                        </div>
                        <div class="col-md-4">
                            <button id="btnIrEntregasComZona" type="button"
                                class="btn btn-secondary w-100 mt-md-4">Encomendas Disponíveis</button>
                        </div>
                        <div class="col-md-4">
                            <a href="/estafeta/minhas-entregas" class="btn btn-secondary w-100 mt-md-4">Minhas
                                Entregas</a>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Gráfico de Evolução Mensal -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h6 text-muted fw-bold text-uppercase mb-3">Evolução Mensal (Entregas Realizadas)</h2>
                    <canvas id="evolucaoMensalChart" style="max-height: 300px;"></canvas>
                </div>
            </div>


        </main>

        <script src="/javascript/estafetaDashboardAcoes.js"></script>
        <script src="/javascript/graficoEstafeta.js"></script>

</body>

</html>
<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-white">
    <%- include('../partials/navbar') %>

    <main class="container py-4">
        <h1 class="h4 mb-4 pb-2 border-bottom text-dark">Painel do Estafeta</h1>

        <div class="row g-3">
            <!-- Sidebar de Gestão -->
            <div class="col-md-4">
                <div class="list-group mb-4">
                    <a href="/estafeta/entregas" id="linkEntregasDisponiveis" class="list-group-item list-group-item-action">Encomendas Disponíveis</a>
                    <a href="/estafeta/minhas-entregas" class="list-group-item list-group-item-action">Minhas Entregas</a>
                    <a href="/estafeta/perfil" class="list-group-item list-group-item-action">Meu Perfil</a>
                </div>

                <!-- Configuração de Zona Integrada na Sidebar -->
                <div class="border p-3">
                    <h2 class="h6 text-secondary fw-bold text-uppercase mb-3" style="font-size: 0.7rem;">Configuração de Zona</h2>
                    <label for="zonaTrabalhoDashboard" class="form-label small fw-bold mb-1">Zona de Trabalho</label>
                    <select id="zonaTrabalhoDashboard" class="form-select form-select-sm border" data-estafeta-id="<%= estafetaId || '' %>">
                        <option value="">Todas as zonas</option>
                        <% (zonasTrabalho || []).forEach((zona)=> { %>
                            <option value="<%= zona.value %>">
                                <%= zona.label %>
                            </option>
                        <% }); %>
                    </select>
                    <small class="text-muted d-block mt-2" style="font-size: 0.7rem;">Filtra as encomendas disponíveis pela zona selecionada.</small>
                    <button id="btnIrEntregasComZona" type="button" class="btn btn-sm btn-light border text-dark">Ver Encomendas na Zona</button>
                </div>
            </div>

            <!-- Estatísticas -->
            <div class="col-md-8">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="border p-3 text-center h-100">
                            <div class="text-secondary small text-uppercase" style="font-size: 0.65rem;">Entregas Realizadas</div>
                            <div class="h2 mb-0"><%= stats.entregasRealizadas %></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border p-3 text-center h-100">
                            <div class="text-secondary small text-uppercase" style="font-size: 0.65rem;">Em Curso</div>
                            <div class="h2 mb-0"><%= stats.entregasEmCurso %></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border p-3 text-center h-100">
                            <div class="text-secondary small text-uppercase" style="font-size: 0.65rem;">Ganhos Totais</div>
                            <div class="h2 mb-0"><%= Number(stats.ganhosTotais || 0).toFixed(2) %>€</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border p-3 text-center h-100">
                            <div class="text-secondary small text-uppercase" style="font-size: 0.65rem;">Avaliação Média</div>
                            <div class="h2 mb-0"><%= stats.mediaAvaliacao ?? 0 %> / 5</div>
                            <div class="text-secondary small" style="font-size: 0.65rem;"><%= stats.totalAvaliacoes ?? 0 %> avaliação(ões)</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border p-3 text-center h-100">
                            <div class="text-secondary small text-uppercase" style="font-size: 0.65rem;">Disponíveis na Rede</div>
                            <div class="h2 mb-0"><%= stats.entregasDisponiveis ?? 0 %></div>
                            <% if (stats.mercadoLider) { %>
                                <div class="text-muted small mt-1" style="font-size: 0.65rem;">Pico: <%= stats.mercadoLider.localizacao %></div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Gráfico de Evolução -->
                <div class="border p-3">
                    <h2 class="h6 text-secondary fw-bold text-uppercase mb-3" style="font-size: 0.7rem;">Evolução Mensal (Entregas)</h2>
                    <div style="position: relative; height: 250px;">
                        <canvas id="evolucaoMensalChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div id="chart-data" data-evolucao-mensal="<%= JSON.stringify(stats.evolucaoMensal || []) %>" style="display: none;"></div>
    </main>

    <script src="/javascript/estafeta/estafetaDashboardAcoes.js"></script>
    <script src="/javascript/estafeta/graficoEstafeta.js"></script>
</body>

</html>

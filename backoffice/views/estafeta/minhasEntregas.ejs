<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold">Gestão de Entregas</h4>
            </div>

            <% const emCurso = entregas.filter(e => e.estado === 'em_entrega'); %>
            <% if (emCurso.length > 0) { %>
                <h5 class="fw-bold mb-3">Em Curso</h5>
                <div class="row mb-4">
                    <% emCurso.forEach(entrega => { %>
                        <div class="col-md-6 mb-3">
                            <div class="card border shadow-sm">
                                <div class="card-body">
                                    <h6 class="fw-bold">#<%= entrega._id.toString().slice(-6).toUpperCase() %></h6>
                                    <p class="small mb-2">
                                        <strong>De:</strong> <%= entrega.supermercadoId?.nome || 'N/A' %><br>
                                        <strong>Para:</strong> <%= entrega.moradaEntrega || entrega.clienteId?.morada || 'N/A' %>
                                    </p>
                                    <button class="btn btn-sm btn-light border btn-confirmar-entrega" data-id="<%= entrega._id %>">
                                        Entregar ao cliente
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>

            <% const aguardando = entregas.filter(e => e.estado === 'aguarda_validacao'); %>
            <% if (aguardando.length > 0) { %>
                <h5 class="fw-bold mb-3">A aguardar confirmação do cliente</h5>
                <div class="row mb-4">
                    <% aguardando.forEach(entrega => { %>
                        <div class="col-md-6 mb-3">
                            <div class="card border-dark shadow-none bg-white">
                                <div class="card-body">
                                    <h6 class="fw-bold">#<%= entrega._id.toString().slice(-6).toUpperCase() %></h6>
                                    <p class="small mb-0 text-muted">
                                        <strong>Loja:</strong> <%= entrega.supermercadoId?.nome || 'N/A' %><br>
                                        <strong>Destino:</strong> <%= entrega.moradaEntrega || entrega.clienteId?.morada || 'N/A' %>
                                    </p>
                                    <div class="mt-2">
                                        <span class="badge border border-dark text-dark py-2 px-3">AGUARDA VALIDAÇÃO</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>

            <% const historico = entregas.filter(e => e.estado === 'entregue'); %>
            <% if (historico.length > 0) { %>
                <h5 class="fw-bold mb-3">Histórico de Concluídas</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-hover border">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Supermercado</th>
                                <th>Destino</th>
                                <th>Data</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% historico.forEach(entrega => { %>
                                <tr>
                                    <td class="fw-bold">#<%= entrega._id.toString().slice(-6).toUpperCase() %></td>
                                    <td><%= entrega.supermercadoId?.nome || 'N/A' %></td>
                                    <td><%= entrega.moradaEntrega || entrega.clienteId?.morada || 'N/A' %></td>
                                    <td><%= new Date(entrega.criadoEm).toLocaleDateString('pt-PT') %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>

            <% if (entregas.length === 0) { %>
                <div class="text-center py-5 text-muted">
                    <p>Ainda não tens nenhuma atividade de entrega registada.</p>
                </div>
            <% } %>
        </div>

        <script src="/javascript/estafeta/estafetaAcoes.js"></script>
</body>

</html>

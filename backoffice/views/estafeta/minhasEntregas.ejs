<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Minhas Entregas</h4>
            </div>

            <% const emCurso=entregas.filter(e=> e.estado === 'em_entrega'); %>
                <% if (emCurso.length> 0) { %>
                    <h5>Em Curso</h5>
                    <div class="row mb-4">
                        <% emCurso.forEach(entrega=> { %>
                            <div class="col-md-6 mb-3">
                                <div class="card border-primary">
                                    <div class="card-body">
                                        <h6>#<%= entrega._id.toString().slice(-6).toUpperCase() %>
                                        </h6>
                                        <p class="small mb-2">
                                            <strong>De:</strong>
                                            <%= entrega.supermercadoId?.nome || 'N/A' %><br>
                                                <strong>Para:</strong>
                                                <%= entrega.moradaEntrega || entrega.clienteId?.morada || 'N/A' %>
                                                <% if (entrega.coordenadasEntrega && Number.isFinite(entrega.coordenadasEntrega.lat) && Number.isFinite(entrega.coordenadasEntrega.lng)) { %>
                                                    <br>
                                                    <strong>Coords:</strong> <%= entrega.coordenadasEntrega.lat %>, <%= entrega.coordenadasEntrega.lng %>
                                                <% } %>
                                        </p>
                                        <button class="btn btn-sm btn-dark btn-confirmar-entrega"
                                            data-id="<%= entrega._id %>">
                                            Confirmar Entrega
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>

                        <% const aguardaConfirmacao=entregas.filter(e=> e.estado === 'aguarda_confirmacao'); %>
                            <% if (aguardaConfirmacao.length > 0) { %>
                                <h5>Aguarda Confirmação do Cliente</h5>
                                <table class="table table-sm mb-4">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Supermercado</th>
                                            <th>Destino</th>
                                            <th>Data</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% aguardaConfirmacao.forEach(entrega=> { %>
                                            <tr>
                                                <td>#<%= entrega._id.toString().slice(-6).toUpperCase() %></td>
                                                <td><%= entrega.supermercadoId?.nome || 'N/A' %></td>
                                                <td><%= entrega.moradaEntrega || entrega.clienteId?.morada || 'N/A' %></td>
                                                <td><%= new Date(entrega.criadoEm).toLocaleDateString('pt-PT') %></td>
                                                <td><span class="badge bg-dark">A aguardar</span></td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            <% } %>

                        <% const historico=entregas.filter(e=> e.estado === 'entregue'); %>
                            <% if (historico.length> 0) { %>
                                <h5>Histórico</h5>
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Supermercado</th>
                                            <th>Destino</th>
                                            <th>Data</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% historico.forEach(entrega=> { %>
                                            <tr>
                                                <td>#<%= entrega._id.toString().slice(-6).toUpperCase() %>
                                                </td>
                                                <td>
                                                    <%= entrega.supermercadoId?.nome || 'N/A' %>
                                                </td>
                                                <td>
                                                    <%= entrega.moradaEntrega || entrega.clienteId?.morada || 'N/A' %>
                                                    <% if (entrega.coordenadasEntrega && Number.isFinite(entrega.coordenadasEntrega.lat) && Number.isFinite(entrega.coordenadasEntrega.lng)) { %>
                                                        <br>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <%= new Date(entrega.criadoEm).toLocaleDateString('pt-PT') %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                                <% } %>

        </div>

        <script src="/javascript/estafeta/estafetaAcoes.js"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

        <main class="container py-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 fw-bold m-0">Encomendas</h1>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Cliente</th>
                                <th>Total</th>
                                <th>Estado</th>
                                <th>Data</th>
                                <th class="text-end">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (encomendas && encomendas.length> 0) { %>
                                <% encomendas.forEach(function(encomenda) { %>
                                    <tr>
                                        <td>
                                            <div class="fw-bold">
                                                <%= encomenda.clienteId ? encomenda.clienteId.nome
                                                    : 'Cliente Desconhecido' %>
                                            </div>
                                            <div class="small text-muted">
                                                <%= encomenda.clienteId ? encomenda.clienteId.email : '' %>
                                            </div>
                                        </td>
                                        <td>
                                            <%= Number(encomenda.valorTotal || 0).toFixed(2) %>EUR
                                        </td>
                                        <td>
                                            <span class="badge bg-dark">
                                                <%= encomenda.estado %>
                                            </span>
                                        </td>
                                        <td class="small text-muted">
                                            <%= new Date(encomenda.criadoEm).toLocaleDateString('pt-PT') %>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                <% const permitidos = transicoesPermitidas[encomenda.estado] || []; %>
                                                <% if (permitidos.length > 0) { %>
                                                    <form action="/supermercado/encomendas/<%= encomenda._id %>/estado"
                                                        method="POST" class="d-inline-flex gap-2">
                                                        <select name="estado" class="form-select form-select-sm" style="width: auto;">
                                                            <option value="<%= encomenda.estado %>" selected disabled><%= encomenda.estado %></option>
                                                            <% permitidos.forEach(function(e) { %>
                                                                <option value="<%= e %>"><%= e %></option>
                                                            <% }) %>
                                                        </select>
                                                        <button type="submit" class="btn btn-sm btn-dark">Atualizar</button>
                                                    </form>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Estado final</span>
                                                <% } %>
                                                <% if (encomenda.faturaNumero) { %>
                                                    <a href="/supermercado/encomendas/<%= encomenda._id %>/fatura"
                                                        class="btn btn-sm btn-light border" target="_blank">Fatura</a>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted">Ainda não existem
                                                    encomendas.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <script>
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('success')) {
                alert('Ação concluída');
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        </script>
</body>

</html>
<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

        <main class="container py-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 fw-bold m-0">Registar Venda em Caixa</h1>
                <button type="submit" form="formVendaCaixa" class="btn btn-primary fw-bold px-4">Registar Venda</button>
            </div>

            <form id="formVendaCaixa" action="/supermercado/vendas" method="POST" class="card border-0 shadow-sm p-4">

                <h2 class="h6 fw-bold mb-3">Dados do Cliente</h2>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Email do Cliente</label>
                        <input type="email" name="emailCliente" class="form-control" placeholder="exemplo@email.com">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Nome do Cliente</label>
                        <input type="text" name="nomeCliente" class="form-control" placeholder="Nome Completo">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">NIF (Opcional)</label>
                        <input type="text" name="nifCliente" class="form-control" placeholder="999999999" maxlength="9">
                    </div>
                </div>

                <h2 class="h6 fw-bold mb-3">Entrega e Logística</h2>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Método de Entrega</label>
                        <select name="metodoEntrega" id="metodoEntregaVenda" class="form-select" required>
                            <option value="levantamento em loja">Levantamento em Loja</option>
                            <option value="entrega ao domicilio">Entrega ao Domicílio (Estafeta)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold" id="labelMorada">Morada de Destino</label>
                        <input type="text" name="moradaCliente" id="moradaVenda" class="form-control">
                        <small class="text-muted" id="hintMorada">Obrigatória apenas para entregas ao domicílio.</small>
                    </div>
                </div>

                <div class="row g-4 venda-caixa-layout mb-3">
                    <div class="col-lg-8" id="colProdutosVenda">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="h6 fw-bold mb-0">Produtos no Carrinho</h2>
                            <button type="button" class="btn btn-sm btn-primary px-3" data-bs-toggle="modal" data-bs-target="#modalPesquisaProduto">+ Adicionar Produtos</button>
                        </div>

                        <!-- Tabela principal do Carrinho -->
                        <div class="card border-0 shadow-sm table-responsive mb-0">
                            <table class="table table-sm align-middle venda-caixa-tabela mb-0" id="tabelaCarrinho">
                                <thead class="table-light">
                                    <tr>
                                        <th>Produto</th>
                                        <th>Preço Unit.</th>
                                        <th style="width: 120px;">Quantidade</th>
                                        <th class="text-end">Total</th>
                                        <th style="width: 50px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="tabelaCarrinhoBody">
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-5">
                                            Ainda não adicionaste produtos.<br>
                                            <small>Clica em "Adicionar Produtos" para adicionar produtos ao carrinho.</small>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    </div>

                    <div class="col-lg-4" id="colMapaEntrega">
                        <div class="venda-caixa-mapa-sticky">
                            <h2 class="h6 fw-bold mb-3" id="tituloMapaEntrega">Localização de Entrega</h2>
                            <div class="card border-0 bg-light p-3" id="blocoMapaEntrega">
                                <p class="small text-muted mb-2">Clique no mapa para escolher as coordenadas da entrega
                                    ao domicílio.</p>
                                <div id="mapaEscolherEntrega" class="venda-caixa-mapa"
                                    data-super-lat="<%= supermercado && supermercado.localizacaoGeo && supermercado.localizacaoGeo.coordinates ? supermercado.localizacaoGeo.coordinates[1] : '' %>"
                                    data-super-lng="<%= supermercado && supermercado.localizacaoGeo && supermercado.localizacaoGeo.coordinates ? supermercado.localizacaoGeo.coordinates[0] : '' %>"
                                    data-super-raio="<%= supermercado && supermercado.raioAtuacao ? supermercado.raioAtuacao : 5 %>"
                                    data-super-nome="<%= supermercado && supermercado.nome ? supermercado.nome : 'Supermercado' %>">
                                </div>
                                <small class="text-muted mt-2 d-block" id="coordsSelecionadas">Nenhuma coordenada
                                    selecionada.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <input type="hidden" id="itensVenda" name="itens" value="[]">
                <input type="hidden" id="latitudeEntrega" name="latitudeEntrega" value="">
                <input type="hidden" id="longitudeEntrega" name="longitudeEntrega" value="">
            </form>
        </main>
        
    <div class="modal fade" id="modalPesquisaProduto" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Procurar Produtos</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-2">
                    <div class="card border-0 bg-light p-2 mb-3">
                        <div class="row g-2">
                            <div class="col-md-7">
                                <input type="text" id="produtoPesquisaInput" data-produto-pesquisa="input"
                                    class="form-control" placeholder="Escreve o nome do produto...">
                            </div>
                            <div class="col-md-5">
                                <select id="produtoPesquisaCategoria" data-produto-pesquisa="categoria" class="form-select">
                                    <option value="">Todas as categorias</option>
                                    <% if (categorias && categorias.length > 0) { %>
                                        <% categorias.forEach(function(cat) { %>
                                            <option value="<%= cat._id %>"><%= cat.nome %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <div class="table-responsive" style="max-height: 50vh; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Código de Barras</th>
                                    <th>Preço</th>
                                    <th>Stock</th>
                                    <th style="min-width: 140px;">Qtd.</th>
                                </tr>
                            </thead>
                            <tbody id="produtoPesquisaTabelaBody" data-produto-pesquisa="tabela">
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">Utiliza a barra de pesquisa para carregar produtos.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
        <script src="/javascript/mapa.js"></script>
        <script src="/javascript/pesquisaProdutos.js"></script>
        <script src="/javascript/vendaCaixaAcoes.js"></script>

</body>

</html>
<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

        <main class="container py-5">
            <div class="mx-auto" style="max-width: 600px;">
                <div class="card p-4 border-0 shadow-sm">
                    <h2 class="h4 fw-bold mb-4 text-center">Novo Produto</h2>

                    <form action="/supermercado/produtos" method="POST" id="formCriar" enctype="multipart/form-data" novalidate>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Nome do Produto</label>
                            <input type="text" name="nome" id="nome" class="form-control" required>
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Código de Barras (Opcional - Min. 9 caracteres)</label>
                            <input type="text" name="codigoBarras" id="codigoBarras" class="form-control" placeholder="Ex: 560123456">
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Categoria</label>
                            <select name="categoriaId" id="categoriaId" class="form-select" required>
                                <% categorias.forEach(function(cat) { %>
                                    <option value="<%= cat._id %>"><%= cat.nome %></option>
                                <% }) %>
                            </select>
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Imagem do Produto</label>
                            <input type="file" name="imagem" id="imagem" class="form-control" accept="image/*" required>
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Descrição (Opcional)</label>
                            <textarea name="descricao" id="descricao" class="form-control" rows="2"
                                placeholder="Breve descrição do produto"></textarea>
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="row g-3 mb-2">
                            <div class="col-6">
                                <label class="form-label fw-bold small">Preço Atual (€)</label>
                                <input type="number" step="0.01" min="0.01" name="preco" id="preco" class="form-control" required>
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Stock</label>
                                <input type="number" min="0" name="stockDisponivel" id="stockDisponivel" class="form-control" required>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small">Preço Original / Promoção (Opcional)</label>
                            <input type="number" step="0.01" min="0" name="precoAntigo" id="precoAntigo" class="form-control" value="0">
                            <div class="invalid-feedback"></div>
                            <div id="previsaoDesconto" class="mt-2"></div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100 fw-bold">Guardar Produto</button>
                            <a href="/supermercado/produtos" class="btn btn-light w-100">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <script src="/javascript/userValidator.js"></script>
        <script src="/javascript/supermercado/produtoCriarEditar.js"></script>

</body>

</html>

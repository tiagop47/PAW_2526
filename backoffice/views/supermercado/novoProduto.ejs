<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

        <main class="container py-5">
            <div class="mx-auto" style="max-width: 600px;">
                <div class="card p-4 border-0 shadow-sm">
                    <h2 class="h4 fw-bold mb-4 text-center">Novo Produto</h2>

                    <form action="/supermercado/produtos" method="POST" id="formCriar" enctype="multipart/form-data" novalidate>
                        <input type="hidden" name="catalogProductId" id="catalogProductId" value="">

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Produto do Catálogo (opcional)</label>
                            <select id="catalogoSelect" class="form-select">
                                <option value="">— Criar produto novo —</option>
                                <% catalogo.forEach(function(cp) { %>
                                    <option value="<%= cp._id %>"
                                        data-nome="<%= cp.nome %>"
                                        data-categoria="<%= cp.categoriaId ? cp.categoriaId._id : '' %>">
                                        <%= cp.nome %> (<%= cp.categoriaId ? cp.categoriaId.nome : 'Sem categoria' %>)
                                    </option>
                                <% }) %>
                            </select>
                            <div class="form-text">Selecione um produto existente no catálogo para permitir a comparação de preços entre supermercados.</div>
                        </div>

                        <hr class="mb-3">

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Nome do Produto</label>
                            <input type="text" name="nome" id="nome" class="form-control" minlength="2" maxlength="100" required>
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Código de Barras (Opcional - EAN-13: 12-13 dígitos)</label>
                            <input type="text" name="codigoBarras" id="codigoBarras" class="form-control" placeholder="Ex: 560123456789">
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Categoria</label>
                            <select name="categoriaId" id="categoriaId" class="form-select" required>
                                <% categorias.forEach(function(cat) { %>
                                    <option value="<%= cat._id %>"><%= cat.nome %></option>
                                <% }) %>
                            </select>
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Imagem do Produto</label>
                            <input type="file" name="imagem" id="imagem" class="form-control" accept="image/*" required>
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Descrição (Opcional)</label>
                            <textarea name="descricao" id="descricao" class="form-control" rows="2"
                                placeholder="Breve descrição do produto"></textarea>
                            <div class="invalid-feedback"></div>
                        </div>

                        <div class="row g-3 mb-2">
                            <div class="col-6">
                                <label class="form-label fw-bold small">Preço Atual (€)</label>
                                <input type="number" step="0.01" min="0.01" name="preco" id="preco" class="form-control" required>
                                <div class="invalid-feedback"></div>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Stock</label>
                                <input type="number" min="0" name="stockDisponivel" id="stockDisponivel" class="form-control" required>
                                <div class="invalid-feedback"></div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small">Preço Original / Promoção (Opcional)</label>
                            <input type="number" step="0.01" min="0" name="precoAntigo" id="precoAntigo" class="form-control" value="0">
                            <div class="invalid-feedback"></div>
                            <div id="previsaoDesconto" class="mt-2"></div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100 fw-bold">Guardar Produto</button>
                            <a href="/supermercado/produtos" class="btn btn-light w-100">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <script src="/javascript/userValidator.js"></script>
        <script src="/javascript/supermercado/produtoCriarEditar.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const catalogoSelect = document.getElementById('catalogoSelect');
                const catalogProductIdInput = document.getElementById('catalogProductId');
                const nomeInput = document.getElementById('nome');
                const categoriaSelect = document.getElementById('categoriaId');

                catalogoSelect.addEventListener('change', function() {
                    const selected = this.options[this.selectedIndex];
                    const catalogId = this.value;

                    if (catalogId) {
                        // Produto do catálogo selecionado
                        catalogProductIdInput.value = catalogId;
                        nomeInput.value = selected.dataset.nome;
                        nomeInput.readOnly = true;
                        nomeInput.classList.add('bg-light');

                        const catId = selected.dataset.categoria;
                        if (catId) {
                            categoriaSelect.value = catId;
                        }
                        categoriaSelect.disabled = true;
                        // Hidden input para submeter o valor de categoriaId quando disabled
                        let hiddenCat = document.getElementById('categoriaIdHidden');
                        if (!hiddenCat) {
                            hiddenCat = document.createElement('input');
                            hiddenCat.type = 'hidden';
                            hiddenCat.name = 'categoriaId';
                            hiddenCat.id = 'categoriaIdHidden';
                            categoriaSelect.parentNode.appendChild(hiddenCat);
                        }
                        hiddenCat.value = catId;
                    } else {
                        // Criar produto novo
                        catalogProductIdInput.value = '';
                        nomeInput.value = '';
                        nomeInput.readOnly = false;
                        nomeInput.classList.remove('bg-light');
                        categoriaSelect.disabled = false;
                        const hiddenCat = document.getElementById('categoriaIdHidden');
                        if (hiddenCat) hiddenCat.remove();
                    }
                });
            });
        </script>

</body>

</html>

<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

        <main class="container py-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <a href="/supermercado/produtos/novo" class="btn btn-primary fw-bold">
                    + Novo Produto
                </a>
                <h1 class="h4 fw-bold m-0">Gestão de Produtos</h1>
            </div>

            <div class="card border-0 shadow-sm mb-3 p-3">
                <div class="row g-2">
                    <div class="col-md-8">
                        <input id="produtoPesquisaInput" data-produto-pesquisa="input" type="text" class="form-control"
                            placeholder="Pesquisar por nome...">
                    </div>
                    <div class="col-md-4">
                        <select id="produtoPesquisaCategoria" data-produto-pesquisa="categoria" class="form-select">
                            <option value="">Todas as categorias</option>
                            <% categorias.forEach(function(cat) { %>
                                <option value="<%= cat._id %>">
                                    <%= cat.nome %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <table class="tabela-limpa mb-0">
                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Categoria</th>
                            <th>Preço</th>
                            <th>Stock</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody id="produtoPesquisaTabelaBody" data-produto-pesquisa="tabela">
                        <% if (locals.produtos && produtos.length> 0) { %>
                            <% produtos.forEach(function(p) { %>
                                <tr>
                                    <td>
                                        <%= p.nome %>
                                    </td>
                                    <td>
                                        <%= p.categoriaId ? p.categoriaId.nome : 'Sem categoria' %>
                                    </td>
                                    <td>
                                        <%= p.preco %>€
                                    </td>
                                    <td>
                                        <%= p.stockDisponivel %>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="/supermercado/produtos/<%= p._id %>"
                                                class="btn btn-sm btn-light border">Detalhes</a>
                                            <a href="/supermercado/produtos/editar/<%= p._id %>"
                                                class="btn btn-sm btn-light border">Editar</a>
                                            <form action="/supermercado/produtos/eliminar/<%= p._id %>" method="POST"
                                                class="d-inline" onsubmit="return confirm('Tem a certeza?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">Nenhum produto
                                                registado.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </main>

        <script src="/javascript/supermercado/supermercadoAcoes.js"></script>
        <script src="/javascript/supermercado/pesquisaProdutos.js"></script>
        <script>
            inicializarPesquisaProdutos();
        </script>

</body>

</html>
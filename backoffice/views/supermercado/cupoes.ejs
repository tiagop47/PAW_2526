<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">
    <%- include('../partials/navbar') %>

        <main class="container py-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 fw-bold m-0 text-dark">Gestão de Cupões</h1>
            </div>

            <div class="row g-4">

                                <!-- Formulário de Criação -->
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-body">
                                            <h5 class="card-title h6 mb-3">Novo Cupão</h5>
                                            <form action="/supermercado/cupoes" method="POST">
                                                <div class="mb-3">
                                                    <label class="form-label small">Código do Cupão</label>
                                                    <input type="text" name="codigo" class="form-control text-uppercase"
                                                        required minlength="2" maxlength="30" placeholder="Ex: PROMO10">
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small">% Desconto</label>
                                                    <input type="number" class="form-control" name="percentagemDesconto"
                                                        min="1" max="100" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small">Data de Validade</label>
                                                    <input type="date" class="form-control" name="prazo" required
                                                        min="<%= new Date().toISOString().split('T')[0] %>">
                                                </div>
                                                <button type="submit" class="btn btn-sm btn-dark w-100">Criar
                                                    Cupão</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Tabela de Cupões -->
                                <div class="col-md-8">
                                    <div class="card border-0 shadow-sm">
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Código</th>
                                                        <th class="text-center">Desconto</th>
                                                        <th class="text-center">Validade</th>
                                                        <th class="text-center">Estado</th>
                                                        <th class="text-center">Ações</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (cupoes && cupoes.length> 0) { %>
                                                        <% cupoes.forEach(function(cupao) { const expirado=new
                                                            Date(cupao.prazo) < new Date(); const ativo=cupao.ativo &&
                                                            !expirado; %>
                                                            <tr>
                                                                <td class="fw-bold">
                                                                    <%= cupao.codigo %>
                                                                </td>
                                                                <td class="text-center fw-bold">
                                                                    <%= cupao.percentagemDesconto %>%
                                                                </td>
                                                                <td class="text-center small">
                                                                    <%= new
                                                                        Date(cupao.prazo).toLocaleDateString('pt-PT') %>
                                                                </td>
                                                                <td class="text-center">
                                                                    <% if (ativo) { %>
                                                                        <span class="badge bg-dark">Ativo</span>
                                                                        <% } else if (expirado) { %>
                                                                            <span
                                                                                class="badge bg-secondary text-white">Expirado</span>
                                                                            <% } else { %>
                                                                                <span
                                                                                    class="badge bg-secondary text-white">Inativo</span>
                                                                                <% } %>
                                                                </td>
                                                                <td class="text-center">
                                                                    <div class="d-flex justify-content-center gap-2">
                                                                        <% if (!expirado) { %>
                                                                            <% if (cupao.ativo) { %>
                                                                                <form
                                                                                    action="/supermercado/cupoes/desativar/<%= cupao._id %>"
                                                                                    method="POST">
                                                                                    <button type="submit"
                                                                                        class="btn btn-sm btn-light border text-dark">
                                                                                        Desativar
                                                                                    </button>
                                                                                </form>
                                                                                <% } else { %>
                                                                                    <form
                                                                                        action="/supermercado/cupoes/ativar/<%= cupao._id %>"
                                                                                        method="POST">
                                                                                        <button type="submit"
                                                                                            class="btn btn-sm btn-light border text-dark">
                                                                                            Ativar
                                                                                        </button>
                                                                                    </form>
                                                                                    <% } %>
                                                                                        <% } %>
                                                                                            <form
                                                                                                action="/supermercado/cupoes/eliminar/<%= cupao._id %>"
                                                                                                method="POST">
                                                                                                <button type="submit"
                                                                                                    class="btn btn-sm btn-outline-danger border"
                                                                                                    onclick="return confirm('Tens a certeza que queres eliminar este cupão?')">
                                                                                                    Eliminar
                                                                                                </button>
                                                                                            </form>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                                <% } else { %>
                                                                    <tr>
                                                                        <td colspan="5"
                                                                            class="text-center py-4 text-muted">Nenhum
                                                                            cupão criado.</td>
                                                                    </tr>
                                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
        </main>
</body>

</html>
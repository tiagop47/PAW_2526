<!DOCTYPE html>
<html lang="pt">
<head>
    <%- include('../partials/head') %>
</head>
<body class="bg-white">
    <%- include('../partials/navbar') %>
    <main class="container py-4">
        <div class="row mb-4 border-bottom pb-2">
            <div class="col">
                <h1 class="h4 fw-bold">Avaliações dos Clientes</h1>
                <p class="text-muted small">Média Global: <%= media %> / 5.0 (<%= total %> feedback/s)</p>
            </div>
            <div class="col-auto">
                <a href="/supermercado/dashboard" class="btn btn-sm btn-outline-dark">Voltar ao Painel</a>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <% if (avaliacoes && avaliacoes.length > 0) { %>
                    <div class="list-group list-group-flush border">
                        <% avaliacoes.forEach(function(av) { %>
                            <div class="list-group-item py-3">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold small text-uppercase">Pedido #<%= av.encomendaId.toString().substring(18).toUpperCase() %></span>
                                    <span class="badge border text-dark fw-normal small">Nota: <%= av.notaSupermercado %>/5</span>
                                </div>
                                <div class="my-2 small"><%= av.clienteId?.nome || 'Cliente' %> • <%= new Date(av.criadoEm).toLocaleDateString('pt-PT') %></div>
                                <p class="mb-0 text-dark small fst-italic">"<%= av.comentario || 'Sem comentário.' %>"</p>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="alert alert-light border text-center py-5">
                        Não existem avaliações registadas para este supermercado.
                    </div>
                <% } %>
            </div>
        </div>
    </main>
</body>
</html>

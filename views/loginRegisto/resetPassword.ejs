<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/stylesheets/base.css">
    <link rel="stylesheet" href="/stylesheets/components.css">
</head>

<body class="bg-light">

    <main class="auth-container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
        <div class="card shadow border-0 p-4" style="max-width: 450px; width: 100%; border-radius: 20px;">
            <header class="text-center mb-4">
                <h2 class="fw-bold text-primary">Repor Palavra-passe</h2>
                <p class="text-muted small">Cria uma nova palavra-passe para a tua conta</p>
            </header>

            <% if (locals.errorMessage) { %>
                <div class="alert alert-danger small">
                    <%= errorMessage %>
                </div>
            <% } %>

            <form action="/auth/reset-password/<%= token %>" method="POST">
                
                <div class="mb-3">
                    <label for="password" class="form-label small fw-bold text-muted">Nova Palavra-passe</label>
                    <input type="password" class="form-control py-2" id="password" name="password" placeholder="Nova Password" required>
                </div>

                <div class="mb-4">
                    <label for="confirmPassword" class="form-label small fw-bold text-muted">Confirmar Palavra-passe</label>
                    <input type="password" class="form-control py-2" id="confirmPassword" name="confirmPassword" placeholder="Confirma a Password" required>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">Guardar Nova Password</button>
            </form>
            
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>

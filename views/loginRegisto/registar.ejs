<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Criar Conta </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css" />
</head>

<body>

    <nav class="navbar navbar-dark bg-dark navbar-app">
        <div class="container justify-content-center">
            <a class="navbar-brand fw-bold" href="/">PAW App</a>
        </div>
    </nav>

    <main class="auth-container" style="min-height: calc(100vh - 150px);">
        <div class="card card-auth">
            <header class="text-center mb-4">
                <h2 class="fw-bold text-primary">Nova Conta</h2>
                <p class="text-muted small">Crie o seu perfil para começar</p>
            </header>

            <form action="/auth/registar" method="POST">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="nome" name="nome" placeholder="Nome" required>
                    <label for="nome">Nome Completo</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="email" class="form-control 
                    <% if (locals.errorMessage) { %>is-invalid<% } %>" id="email" name="email"
                        placeholder="nome@exemplo.com" required>
                    <label for="email">Endereço de Email</label>
                    <% if (locals.errorMessage) { %>
                        <div class="invalid-feedback">
                            <%= errorMessage %>
                        </div>
                        <% } %>
                </div>

                <div class="form-floating mb-3 position-relative">
                    <input type="password" class="form-control input-password-toggle" id="password" name="password"
                        placeholder="Password" required>
                    <label for="password">Defina uma Password</label>
                    <button type="button" class="btn-toggle-pass" id="togglePassword">Ver</button>
                </div>

                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="morada" name="morada" placeholder="Morada completa"
                        required>
                    <label for="morada">Morada</label>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="form-floating">
                            <input type="number" class="form-control" id="telefone" name="telefone"
                                placeholder="912345678" required>
                            <label for="telefone">Telemóvel</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-floating">
                            <select class="form-select" id="role" name="role" required>
                                <option value="clientes" selected>Cliente</option>
                                <option value="supermercados">Supermercado</option>
                                <option value="estafetas">Estafeta</option>
                            </select>
                            <label for="role">Tipo de Conta</label>
                        </div>
                    </div>
                </div>
                <input type="hidden" id="g-recaptcha-response" name="g-recaptcha-response">
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mt-2">Registar</button>
            </form>
            <footer class="mt-4 pt-3 border-top text-center">
                <p class="mb-0"> <a href="/auth/login" class="auth-footer-link">Inicie sessão</a></p>
            </footer>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/javascript/mostrarPassword.js"></script>
    <script src="https://www.google.com/recaptcha/api.js?render=<%= siteKey %>"></script>
    <script src="/javascript/recaptcha.js"></script>
</body>

</html>
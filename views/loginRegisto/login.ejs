<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Minha App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css" />
</head>

<body>

    <main class="auth-container">
        <div class="card card-auth">
            <header class="text-center mb-4">
                <h2 class="fw-bold text-primary">Aceder à Conta</h2>
                <p class="text-muted small">Insira os seus dados para continuar</p>
            </header>

            <% if (locals.errorMessage) { %>
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <%= errorMessage %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>

                    <form action="/auth/login" method="POST">
                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="floatingInput" name="email"
                                placeholder="nome@exemplo.com" required>
                            <label for="floatingInput">Endereço de Email</label>
                        </div>

                        <div class="input-group mb-3">
                            <div class="form-floating flex-grow-1">
                                <input type="password" class="form-control input-password-toggle" id="password"
                                    name="password" placeholder="Palavra-passe" required>
                                <label for="password">Palavra-passe</label>
                            </div>
                            <span class="input-group-text btn-toggle-pass" id="togglePassword">Ver</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" name="remember">
                                <label class="form-check-label small" for="rememberMe">Lembrar-me</label>
                            </div>
                            <a href="/auth/recoverPassword" class="small text-decoration-none">Esqueceu-se?</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Entrar</button>
                    </form>

                    <footer class="mt-4 pt-3 border-top text-center">
                        <p class="mb-0">Ainda não tem conta?
                            <a href="/auth/registar" class="auth-footer-link">Registe-se</a>
                        </p>
                    </footer>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/javascript/showPass.js"></script>
</body>

</html>
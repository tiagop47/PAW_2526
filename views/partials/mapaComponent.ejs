<div class="card border bg-white mb-3">
    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
        <span class="small fw-bold text-muted">
            <%= locals.mapaTitulo || 'Geolocalização' %>
        </span>
        <div class="mapa-acoes">
            <%- locals.mapaAcoes || '' %>
        </div>
    </div>
    <div id="<%= locals.mapaId || 'mapa-geral' %>" style="height: <%= locals.mapaAltura || '300px' %>;"></div>
    <% if (locals.mapaFooter) { %>
        <div class="card-footer py-2 text-center">
            <%- mapaFooter %>
        </div>
    <% } %>
</div>

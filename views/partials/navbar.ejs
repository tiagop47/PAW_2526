<header class="cabecalho-principal">
    <div class="container d-flex align-items-center justify-content-between py-2">

        <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse"
            data-bs-target="#menu-principal">
            <i class="bi bi-list fs-2"></i>
        </button>

        <nav class="navegacao-links collapse d-lg-flex align-items-center gap-4" id="menu-principal">
            <% if (user) { %>
                <% if (user.role==='clientes' ) { %>
                    <a href="/cliente/dashboard" class="link-menu">Painel</a>
                    <a href="/cliente/encomendas" class="link-menu">Encomendas</a>
                    <% } %>
                        <% if (user.role==='supermercados' ) { %>
                            <a href="/supermercado/dashboard" class="link-menu">Dashboard</a>
                            <a href="/supermercado/produtos" class="link-menu">Produtos</a>
                            <a href="/supermercado/encomendas" class="link-menu">Vendas</a>
                            <% } %>
                                <% if (user.role==='administrador' ) { %>
                                    <a href="/admin/dashboard" class="link-menu">Admin</a>
                                    <a href="/admin/utilizadores" class="link-menu">Utilizadores</a>
                                    <% } %>
                                        <% } %>
        </nav>

        <div class="area-utilizador d-flex align-items-center">
            <% if (user) { %>
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border shadow-sm"
                        type="button" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false"
                        style="border-radius: 50px; padding: 5px 15px;">
                        <i class="bi bi-person-circle fs-5"></i>
                        <span class="d-none d-md-inline">
                            <%= user.nome %>
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="dropdownUser">
                        <li><a class="dropdown-item py-2" href="/perfil"><i class="bi bi-person me-2"></i> O Meu
                                Perfil</a></li>
                        <li><a class="dropdown-item py-2" href="/configuracoes"><i class="bi bi-gear me-2"></i>
                                Definições</a></li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li><a class="dropdown-item py-2 text-danger" href="/auth/logout"><i
                                    class="bi bi-box-arrow-right me-2"></i>Fechar Painel</a></li>
                    </ul>
                </div>

                <% } %>
        </div>
    </div>
</header>
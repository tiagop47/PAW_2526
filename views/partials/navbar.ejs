<header class="cabecalho-principal">
    <div class="container d-flex align-items-center justify-content-between py-2">
        <!-- Logotipo -->
        <a href="/" class="logotipo d-flex align-items-center gap-2 text-decoration-none">
            <div class="circulo-logo">🛒</div>
            <span class="nome-marca">PAW <span class="text-primary">Market</span></span>
        </a>

        <!-- Navegação Principal -->
        <nav class="navegacao-links d-none d-lg-flex align-items-center gap-4">
            <% if (user) { %>
                <a href="/<%= user.role === 'administrador' ? 'admin' : user.role === 'supermercados' ? 'supermercado' : 'cliente' %>/dashboard" class="link-menu text-decoration-none">Início</a>
                
                <% if (user.role === 'supermercados') { %>
                    <a href="/supermercado/produtos" class="link-menu text-decoration-none">Gerir Produtos</a>
                    <a href="/supermercado/encomendas" class="link-menu text-decoration-none">Encomendas</a>
                <% } %>

                <% if (user.role === 'administrador') { %>
                    <a href="/admin/utilizadores" class="link-menu text-decoration-none">Utilizadores</a>
                <% } %>
            <% } %>
        </nav>

        <!-- Área de Utilizador (Com Perfil e Sair) -->
        <div class="area-utilizador d-flex align-items-center gap-3">
            <% if (user) { %>
                <!-- Link do Perfil -->
                <a href="/perfil" class="text-decoration-none text-dark small fw-bold d-none d-md-inline">
                    <i class="bi bi-person-circle me-1"></i> <%= user.nome %>
                </a>
                
                <!-- Separador Visual -->
                <span class="text-muted d-none d-md-inline">|</span>

                <!-- Botão Sair -->
                <a href="/auth/logout" class="btn btn-outline-danger btn-sm fw-bold px-3" style="border-radius: 4px;">
                    <i class="bi bi-box-arrow-right me-1"></i> Sair
                </a>
            <% } else { %>
                <a href="/auth/login" class="btn btn-primary btn-sm fw-bold px-4" style="border-radius: 4px;">Entrar</a>
            <% } %>
        </div>
    </div>
</header>

<header class="cabecalho-principal">
    <div class="container d-flex align-items-center justify-content-between py-2">
        <!-- Logotipo -->
        <a href="/" class="logotipo text-decoration-none">
            <span class="nome-marca">Dashboard</span></span>
        </a>
        <% if (user) { %>
            <p class="text-secondary small mb-0">Utilizador: <%= user.nome %>
            </p>
            <% } %>

                <nav class="navegacao-links d-none d-lg-flex align-items-center gap-4">
                    <% if (user) { %>
                        <% if (user.role==='supermercados' ) { %>
                            <% } %>
                                <% } %>
                </nav>

                <div class="area-utilizador d-flex align-items-center gap-2">
                    <% if (user) { %>
                        <a href="/auth/logout" class="btn btn-outline-danger btn-sm px-3">Fechar Painel</a>
                        <% } else { %>
                            <a href="/auth/login" class="btn btn-primary btn-sm px-4">Entrar</a>
                            <% } %>
                </div>
    </div>
</header>
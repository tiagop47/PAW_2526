<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

        <main class="container py-5">
            <div class="mx-auto" style="max-width: 600px;">
                <div class="card p-4 border-0 shadow-sm">
                    <h2 class="h4 fw-bold mb-4 text-center">Editar Produto</h2>

                    <form id="formEditar" action="/supermercado/produtos/editar/<%= produto._id %>" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Nome do Produto</label>
                            <input type="text" name="nome" class="form-control" value="<%= produto.nome %>" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small d-block">Imagem do Produto (Opcional)</label>
                            <% if (produto.imagem) { %>
                                <div class="mb-2">
                                    <img src="<%= produto.imagem %>" alt="Atual" class="img-thumbnail" style="height: 100px;">
                                </div>
                            <% } %>
                            <input type="file" name="imagem" class="form-control" accept="image/*">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Descrição</label>
                            <textarea name="descricao" class="form-control" rows="2"><%= produto.descricao %></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Categoria</label>
                            <select name="categoria" class="form-select" required>
                                <option value="Frutas" <%=produto.categoria==='Frutas' ? 'selected' : '' %>>Frutas e
                                    Legumes</option>
                                <option value="Carne" <%=produto.categoria==='Carne' ? 'selected' : '' %>>Carne e Peixe
                                </option>
                                <option value="Laticinios" <%=produto.categoria==='Laticinios' ? 'selected' : '' %>
                                    >Laticínios</option>
                                <option value="Bebidas" <%=produto.categoria==='Bebidas' ? 'selected' : '' %>>Bebidas
                                </option>
                                <option value="Outros" <%=produto.categoria==='Outros' ? 'selected' : '' %>>Outros
                                </option>
                            </select>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <label class="form-label fw-bold small">Preço (€)</label>
                                <input type="number" step="0.01" name="preco" class="form-control"
                                    value="<%= produto.preco %>" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Stock</label>
                                <input type="number" name="stock" class="form-control" value="<%= produto.stockDisponivel %>"
                                    required>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100 fw-bold">Guardar Alterações</button>
                            <a href="/supermercado/produtos" class="btn btn-light w-100">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <script src="/javascript/supermercadoActions.js"></script>

</body>

</html>
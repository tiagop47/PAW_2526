<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

        <main class="container py-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 fw-bold m-0">Gestão de Produtos</h1>
                <a href="/supermercado/produtos/novo" class="btn btn-primary fw-bold">
                    + Novo Produto
                </a>
            </div>

            <div class="card border-0 shadow-sm">
                <table class="tabela-limpa mb-0">
                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Categoria</th>
                            <th>Preço</th>
                            <th>Stock</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (locals.produtos && produtos.length> 0) { %>
                            <% produtos.forEach(function(p) { %>
                                <tr>
                                    <td class="fw-bold">
                                        <a href="/supermercado/produtos/<%= p._id %>"
                                            class="text-decoration-none text-dark">
                                            <%= p.nome %>
                                        </a>
                                    </td>
                                    <td>
                                        <%= p.categoria %>
                                    </td>
                                    <td>
                                        <%= p.preco %>€
                                    </td>
                                    <td>
                                        <%= p.stock %>
                                    </td>
                                    <td>
                                        <a href="/supermercado/produtos/editar/<%= p._id %>"
                                            class="btn btn-sm">Editar</a>
                                        <button class="btn btn-sm text-danger">Eliminar</button>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">Nenhum produto
                                                registado.</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </main>

        <script src="/javascript/supermercadoActions.js"></script>

</body>

</html>
<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

    <main class="container py-5">
        <div class="mx-auto" style="max-width: 600px;">
            <div class="card p-4 border-0 shadow-sm">
                <h2 class="h4 fw-bold mb-4 text-center">Configurações do Supermercado</h2>

                <form action="/supermercado/editar" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Nome Comercial</label>
                        <input type="text" name="nome" class="form-control" value="<%= supermercado.nome %>" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Descrição da Loja</label>
                        <textarea name="descricao" class="form-control" rows="2"><%= supermercado.descricao || '' %></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small d-block">Localização da Loja (Clique no Mapa para Ajustar)</label>
                        <div id="mapa-edicao" style="height: 250px; border-radius: 4px; border: 1px solid #dee2e6;"></div>
                        <div class="d-flex gap-2 mt-2">
                            <% 
                                const lon = (supermercado.localizacaoGeo && supermercado.localizacaoGeo.coordinates) ? supermercado.localizacaoGeo.coordinates[0] : -8.61;
                                const lat = (supermercado.localizacaoGeo && supermercado.localizacaoGeo.coordinates) ? supermercado.localizacaoGeo.coordinates[1] : 41.15;
                            %>
                            <div class="w-50">
                                <label class="small text-muted">Latitude</label>
                                <input type="text" id="input-lat" name="latitude" class="form-control form-control-sm" value="<%= lat %>" readonly required>
                            </div>
                            <div class="w-50">
                                <label class="small text-muted">Longitude</label>
                                <input type="text" id="input-lon" name="longitude" class="form-control form-control-sm" value="<%= lon %>" readonly required>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Horário de Funcionamento</label>
                        <input type="text" name="horarioFuncionamento" class="form-control"
                            value="<%= supermercado.horarioFuncionamento || '' %>" placeholder="Ex: 09:00 - 19:00">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small d-block">Métodos de Entrega</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="metodosEntrega" value="levantamento em loja"
                                <%= supermercado.metodosEntrega.includes('levantamento em loja') ? 'checked' : '' %>>
                            <label class="form-check-label small">Levantamento em Loja</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="metodosEntrega" value="entrega por estafeta"
                                <%= supermercado.metodosEntrega.includes('entrega por estafeta') ? 'checked' : '' %>>
                            <label class="form-check-label small">Entrega por Estafeta</label>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Custo de Entrega (€)</label>
                            <input type="number" step="0.01" name="custoEntrega" class="form-control"
                                value="<%= supermercado.custoEntrega %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Raio de Atuação (km) - "Área Y"</label>
                            <input type="number" name="raioAtuacao" class="form-control" value="<%= supermercado.raioAtuacao %>" min="1" max="50">
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Atualizar Configurações</button>
                        <a href="/supermercado/dashboard" class="btn btn-outline-secondary w-100">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/javascript/supermercadoAcoes.js"></script>
</body>

</html>

<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

        <main class="container py-5">
            <div class="mx-auto" style="max-width: 600px;">
                <div class="card p-4 border-0 shadow-sm">
                    <h2 class="h4 fw-bold mb-4 text-center">Editar Dados do Supermercado</h2>

                    <form action="/supermercado/editar" method="POST">
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Nome do Supermercado</label>
                            <input type="text" name="nome" class="form-control" value="<%= supermercado.nome %>" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Descrição</label>
                            <textarea name="descricao" class="form-control" rows="2"><%= supermercado.descricao || '' %></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Localização</label>
                            <input type="text" name="localizacao" class="form-control" value="<%= supermercado.localizacao %>" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Horário de Funcionamento</label>
                            <input type="text" name="horarioFuncionamento" class="form-control"
                                value="<%= supermercado.horarioFuncionamento || '' %>" placeholder="Ex: 09:00 - 19:00">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Métodos de Entrega</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="metodosEntrega" value="levantamento em loja"
                                    <%= supermercado.metodosEntrega.includes('levantamento em loja') ? 'checked' : '' %>>
                                <label class="form-check-label small">Levantamento em loja</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="metodosEntrega" value="entrega por estafeta"
                                    <%= supermercado.metodosEntrega.includes('entrega por estafeta') ? 'checked' : '' %>>
                                <label class="form-check-label small">Entrega por estafeta</label>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small">Custo de Entrega (€)</label>
                            <input type="number" step="0.01" name="custoEntrega" class="form-control"
                                value="<%= supermercado.custoEntrega %>">
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100 fw-bold">Guardar Alterações</button>
                            <a href="/supermercado/dashboard" class="btn btn-light w-100">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </main>

</body>

</html>

<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-white">

    <%- include('../partials/navbar') %>

        <main class="container py-4">

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="border p-3 text-center">
                        <div class="text-secondary small text-uppercase">Encomendas (Ativas)</div>
                        <div class="h2 mb-0">
                            <%= totalEncomendas %>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border p-3 text-center">
                        <div class="text-secondary small text-uppercase">Produtos Ativos</div>
                        <div class="h2 mb-0">
                            <%= totalProdutos %>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border p-3 text-center">
                        <div class="text-secondary small text-uppercase">Faturação Total</div>
                        <div class="h2 mb-0">
                            <%= Number(vendasTotais).toFixed(2) %>€
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top 5 Produtos Mais Vendidos -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border shadow-sm">
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0 fw-bold">Top 5 Produtos Mais Vendidos (Entregues)</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Produto</th>
                                            <th class="text-center">Quantidade Vendida</th>
                                            <th class="text-end">Faturação Bruta</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (top5Produtos && top5Produtos.length > 0) { %>
                                            <% top5Produtos.forEach(p => { %>
                                                <tr>
                                                    <td class="fw-bold"><%= p.nome %></td>
                                                    <td class="text-center"><%= p.totalVendido %></td>
                                                    <td class="text-end"><%= Number(p.faturado).toFixed(2) %>€</td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" class="text-center text-muted py-4">
                                                    Ainda não existem vendas entregues para calcular estatísticas.
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Janelas de Entrada / Gestão Simples -->
            <h5 class="mb-3">Gestão de Loja</h5>
            <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="border p-3 text-center">
                            <h6>Produtos</h6>
                            <a href="/supermercado/produtos" class="btn btn-sm btn-secondary w-100 mt-2">Abrir</a>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border p-3 text-center">
                            <h6>Encomendas</h6>
                            <a href="/supermercado/encomendas" class="btn btn-sm btn-secondary w-100 mt-2">Gerir</a>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border p-3 text-center">
                            <h6>Venda Caixa</h6>
                            <a href="/supermercado/vendas/nova" class="btn btn-sm btn-secondary w-100 mt-2">Registar</a>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border p-3 text-center">
                            <h6>Configurações</h6>
                            <a href="/supermercado/editar" class="btn btn-sm btn-secondary w-100 mt-2">Editar</a>
                        </div>
                    </div>
                </div>


        </main>

</body>

</html>
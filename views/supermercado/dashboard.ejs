<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

        <main class="container py-4">
            <!-- Boas-vindas -->
            <div class="mb-4">
                <h1 class="h3 mb-1 fw-bold text-dark">Painel de Gestão</h1>
                <p class="text-muted">Bem-vindo, <strong>
                        <%= user.nome %>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="cartao-estatistica">
                        <h6 class="titulo-estatistica">Encomendas Hoje</h6>
                        <div class="d-flex align-items-center justify-content-between">
                            <h2 class="valor-estatistica">12</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="cartao-estatistica">
                        <h6 class="titulo-estatistica">Produtos Ativos</h6>
                        <div class="d-flex align-items-center justify-content-between">
                            <h2 class="valor-estatistica">145</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="cartao-estatistica">
                        <h6 class="titulo-estatistica">Vendas Totais</h6>
                        <div class="d-flex align-items-center">
                            <h2 class="valor-estatistica">842,50€</h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="tabela-limpa">
                        <div class="p-3 bg-white border-bottom">
                            <h5 class="mb-0 fw-bold">Últimas Encomendas</h5>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Cliente</th>
                                        <th>Total</th>
                                        <th>Estado</th>
                                        <th class="text-end">Ação</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>#ORD-5432</td>
                                        <td class="fw-medium">João Silva</td>
                                        <td>45,20€</td>
                                        <td><span class="badge-estado bg-light-warning">Pendente</span></td>
                                        <td class="text-end">
                                            <a href="#" class="btn btn-sm btn-outline-primary botao-acao">Detalhes</a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="cartao-estatistica mb-4">
                        <h5 class="fw-bold mb-3">Ações Rápidas</h5>
                        <div class="d-grid gap-2">
                            <a href="/supermercado/produtos" class="btn btn-outline-primary text-start botao-acao">
                                <i class="bi bi-plus-circle me-2"></i> Adicionar Produto
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <script src="/javascript/navbar.js"></script>
</body>

</html>
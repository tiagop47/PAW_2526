<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-white">

    <%- include('../partials/navbar') %>

    <main class="container py-4">
        <!-- Cabeçalho Simples -->
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
            <div>
                <h1 class="h3 mb-0 text-dark">Painel de Gestão</h1>
                <p class="text-secondary small mb-0">Utilizador: <%= user.nome %></p>
            </div>
            <a href="/supermercado/produtos/novo" class="btn btn-secondary">
                Novo Produto
            </a>
        </div>

        <!-- Estatísticas - Blocos Simples -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="border p-3 text-center">
                    <div class="text-secondary small text-uppercase">Encomendas</div>
                    <div class="h2 mb-0"><%= totalEncomendas %></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border p-3 text-center">
                    <div class="text-secondary small text-uppercase">Produtos Ativos</div>
                    <div class="h2 mb-0"><%= totalProdutos %></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="border p-3 text-center">
                    <div class="text-secondary small text-uppercase">Vendas Totais</div>
                    <div class="h2 mb-0"><%= vendasTotais.toFixed(2) %>€</div>
                </div>
            </div>
        </div>

        <!-- Janelas de Entrada / Gestão Simples -->
        <h5 class="mb-3">Gestão de Loja</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="border p-3 text-center">
                    <h6>Produtos</h6>
                    <a href="/supermercado/produtos" class="btn btn-sm btn-secondary w-100 mt-2">Abrir</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border p-3 text-center">
                    <h6>Encomendas</h6>
                    <a href="/supermercado/encomendas" class="btn btn-sm btn-secondary w-100 mt-2">Gerir</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border p-3 text-center">
                    <h6>Venda Caixa</h6>
                    <a href="/supermercado/vendas/nova" class="btn btn-sm btn-secondary w-100 mt-2">Registar</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border p-3 text-center">
                    <h6>Configurações</h6>
                    <a href="/supermercado/editar" class="btn btn-sm btn-secondary w-100 mt-2">Editar</a>
                </div>
            </div>
        </div>

        <!-- Tabela Simples -->
        <div class="border">
            <div class="p-2 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="mb-0 px-2">Últimas Encomendas</h6>
                <a href="/supermercado/encomendas" class="btn btn-sm btn-secondary">Ver todas</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Cliente</th>
                            <th>Valor</th>
                            <th>Estado</th>
                            <th>Data</th>
                            <th class="text-end pe-3">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (encomendas && encomendas.length > 0) { %>
                            <% encomendas.forEach(encomenda => { %>
                                <tr>
                                    <td class="ps-3"><%= encomenda.clienteId ? encomenda.clienteId.nome : 'N/A' %></td>
                                    <td><%= encomenda.valorTotal.toFixed(2) %>€</td>
                                    <td><%= encomenda.estado %></td>
                                    <td class="text-muted small"><%= new Date(encomenda.criadoEm).toLocaleDateString() %></td>
                                    <td class="text-end pe-3">
                                        <a href="/supermercado/encomendas" class="btn btn-sm btn-secondary">Abrir</a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">Sem encomendas.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script src="/javascript/navbar.js"></script>
</body>

</html>

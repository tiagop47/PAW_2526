<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

        <main class="container py-4">
            <!-- Boas-vindas e Ação Principal -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-1 fw-bold text-dark">Painel de Gestão</h1>
                    <p class="text-muted mb-0">Bem-vindo, <strong><%= user.nome %></strong></p>
                </div>
                <a href="/supermercado/produtos/novo" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-plus-circle me-2"></i> Novo Produto
                </a>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="cartao-estatistica shadow-sm p-3 bg-white border rounded">
                        <h6 class="text-muted text-uppercase small fw-bold">Total de Encomendas</h6>
                        <h2 class="fw-bold mb-0 text-primary"><%= totalEncomendas %></h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="cartao-estatistica shadow-sm p-3 bg-white border rounded">
                        <h6 class="text-muted text-uppercase small fw-bold">Produtos Ativos</h6>
                        <h2 class="fw-bold mb-0 text-success"><%= totalProdutos %></h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="cartao-estatistica shadow-sm p-3 bg-white border rounded">
                        <h6 class="text-muted text-uppercase small fw-bold">Vendas Totais</h6>
                        <h2 class="fw-bold mb-0 text-dark"><%= vendasTotais.toFixed(2) %>€</h2>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-12">
                    <div class="tabela-limpa shadow-sm bg-white border rounded">
                        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold">Últimas Encomendas</h5>
                            <a href="/supermercado/encomendas" class="btn btn-sm btn-link text-decoration-none">Ver todas</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th>Cliente</th>
                                        <th>Total</th>
                                        <th>Estado</th>
                                        <th>Data</th>
                                        <th class="text-end">Ação</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (encomendas && encomendas.length > 0) { %>
                                        <% encomendas.forEach(encomenda => { %>
                                            <tr>
                                                <td class="fw-medium"><%= encomenda.clienteId ? encomenda.clienteId.nome : 'Cliente Desconhecido' %></td>
                                                <td><%= encomenda.valorTotal.toFixed(2) %>€</td>
                                                <td>
                                                    <span class="badge rounded-pill bg-<%= 
                                                        encomenda.estado === 'entregue' ? 'success' : 
                                                        encomenda.estado === 'cancelada' ? 'danger' : 'warning' 
                                                    %>">
                                                        <%= encomenda.estado %>
                                                    </span>
                                                </td>
                                                <td class="text-muted small"><%= new Date(encomenda.criadoEm).toLocaleDateString() %></td>
                                                <td class="text-end">
                                                    <a href="/supermercado/encomendas" class="btn btn-sm btn-outline-primary">Gerir</a>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">Ainda não existem encomendas.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>

</body>

</html>
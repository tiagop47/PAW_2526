<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

    <main class="container py-5">
        <div class="mx-auto" style="max-width: 600px;">
            <div class="card p-4 border-0 shadow-sm">
                <div class="mb-4">
                    <h2 class="h4 fw-bold mb-3 text-center">Detalhes do Produto</h2>
                </div>

                <div class="text-center mb-4">
                    <% if (produto.imagem) { %>
                        <img src="<%= produto.imagem %>" alt="<%= produto.nome %>" class="img-fluid rounded border" style="max-height: 200px; object-fit: contain;">
                    <% } else { %>
                        <div class="bg-light rounded border py-5 text-muted">
                            <i class="bi bi-image display-1"></i>
                            <p class="small mt-2">Sem imagem disponível</p>
                        </div>
                    <% } %>
                </div>

                <!-- Código de Barras -->
                <div class="text-center mb-4">
                    <label class="form-label fw-bold small text-muted d-block mb-2">Código de Barras</label>
                    <svg id="barcodeProduto"></svg>
                </div>

                <!-- Nome e Categoria lado a lado -->
                <div class="row g-3 mb-4">
                    <div class="col-8">
                        <label class="form-label fw-bold small text-muted d-block mb-1">Nome do Produto</label>
                        <p class="fs-5 mb-0 fw-semibold text-truncate text-dark"><%= produto.nome %></p>
                    </div>
                    <div class="col-4 border-start ps-3">
                        <label class="form-label fw-bold small text-muted d-block mb-1">Categoria</label>
                        <span class="badge bg-white text-dark border fw-normal px-2 py-1">
                            <%= produto.categoriaId ? produto.categoriaId.nome : 'Sem categoria' %>
                        </span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold small text-muted d-block mb-1">Descrição</label>
                    <p class="text-dark"><%= produto.descricao || 'Nenhuma descrição fornecida.' %></p>
                </div>

                <div class="row g-3 mb-4 text-dark">
                    <div class="col-4">
                        <label class="form-label fw-bold small text-muted d-block mb-1">Preço Atual</label>
                        <div class="fs-5 fw-bold"><%= produto.preco %>€</div>
                    </div>

                    <% if (produto.precoAntigo > produto.preco) { %>
                        <div class="col-4 border-start ps-3">
                            <label class="form-label fw-bold small text-muted d-block mb-1">Promoção</label>
                            <div class="small">
                                Anterior: <span class="fw-bold"><%= produto.precoAntigo %>€</span><br>
                                Desconto: <span id="percentagemDesconto" data-preco="<%= produto.preco %>" data-preco-antigo="<%= produto.precoAntigo %>" class="fw-bold"></span>
                            </div>
                        </div>
                    <% } %>

                    <div class="col-4 border-start ps-3">
                        <label class="form-label fw-bold small text-muted d-block mb-1">Stock Disponível</label>
                        <div class="fs-5 fw-bold <%= produto.stockDisponivel > 0 ? '' : 'text-danger' %>">
                            <%= produto.stockDisponivel %> <small class="fw-normal text-muted">un.</small>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 pt-3 border-top">
                    <a href="/supermercado/produtos" class="btn btn-light w-100 border">
                        Voltar à Lista
                    </a>
                </div>
            </div>
        </div>
    </main>

    <script src="/javascript/produtoCriarEditar.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <script>
        JsBarcode("#barcodeProduto", "<%= produto._id %>", {
            format: "CODE128",
            width: 1.5,
            height: 50,
            displayValue: true,
            fontSize: 12,
            margin: 5
        });
    </script>

</body>

</html>

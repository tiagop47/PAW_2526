<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/fatura.css">
</head>

<body>
    <div class="no-print">
        <button onclick="window.print()" class="btn btn-primary">Imprimir</button>
    </div>

    <div class="invoice-box">
        <div class="header">
            <div class="company-info">
                <h1>
                    <%= supermercado.nome %>
                </h1>
                <p>
                    <%= supermercado.localizacao %>
                </p>
                <p>NIF: N/A</p>
            </div>
            <div class="invoice-meta" style="text-align: right;">
                <h2>FATURA</h2>
                <p><strong>Número:</strong>
                    <%= encomenda.faturaNumero %>
                </p>
                <p><strong>Data:</strong>
                    <%= encomenda.faturaData.toLocaleDateString('pt-PT') %>
                </p>
                <p><strong>Estado:</strong>
                    <%= encomenda.estado.toUpperCase() %>
                </p>
            </div>
        </div>

        <div class="details">
            <div class="client-info">
                <h3>Cliente</h3>
                <p><strong>Nome:</strong>
                    <%= encomenda.clienteSnapshot.nome %>
                </p>
                <p><strong>NIF:</strong>
                    <%= encomenda.clienteSnapshot.nif %>
                </p>
                <p><strong>Email:</strong>
                    <%= encomenda.clienteSnapshot.email %>
                </p>
                <p><strong>Morada:</strong>
                    <%= encomenda.clienteSnapshot.morada %>
                </p>
            </div>
            <div class="order-info" style="margin-left: 40px;">
                <h3>Detalhes de Entrega</h3>
                <p><strong>Método:</strong>
                    <%= encomenda.metodoEntrega %>
                </p>
                <% if (encomenda.metodoEntrega==='entrega ao domicilio' ) { %>
                    <p><strong>Morada Entrega:</strong>
                        <%= encomenda.moradaEntrega %>
                    </p>
                    <% } %>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Produto</th>
                    <th style="text-align: center;">Qtd</th>
                    <th style="text-align: right;">Preço Unit.</th>
                    <th style="text-align: right;">Total</th>
                </tr>
            </thead>
            <tbody>
                <% encomenda.produtos.forEach(item=> { %>
                    <tr>
                        <td>
                            <%= item.produtoId ? item.produtoId.nome : 'Produto Removido' %>
                        </td>
                        <td style="text-align: center;">
                            <%= item.quantidade %>
                        </td>
                        <td style="text-align: right;">
                            <%= item.precoUnitario.toFixed(2) %> €
                        </td>
                        <td style="text-align: right;">
                            <%= (item.quantidade * item.precoUnitario).toFixed(2) %> €
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>

        <div class="total-section">
            <p>Subtotal: <%= encomenda.valorTotal.toFixed(2) %> €</p>
            <p>IVA (incluído): 0.00 €</p>
            <p class="total-value">TOTAL: <%= encomenda.valorTotal.toFixed(2) %> €</p>
        </div>

        <div class="footer">
            <p>Obrigado pela sua preferência!</p>
        </div>
    </div>
</body>

</html>
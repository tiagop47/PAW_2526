<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-light">
    <%- include('../partials/navbar') %>

        <main class="container py-4">
            <h1 class="h4 mb-4 pb-2 border-bottom text-dark">Administração do Sistema</h1>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="list-group mb-4">
                        <a href="/admin/supermercados/pendentes"
                            class="list-group-item list-group-item-action">Aprovações Pendentes</a>
                        <a href="/admin/exibirUtilizadores" class="list-group-item list-group-item-action">Gestão de
                            Utilizadores</a>
                        <a href="/admin/supermercados/ativos/" class="list-group-item list-group-item-action">Gestão
                            Supermercados</a>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="row g-2 mb-4">
                        <div class="col-md-4">
                            <div class="card card-body bg-white border">
                                <small class="text-muted fw-bold text-uppercase"
                                    style="font-size: 0.65rem;">Utilizadores</small>
                                <div class="h4 mb-0">
                                    <%= stats.totalUsers %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card card-body bg-white border">
                                <small class="text-muted fw-bold text-uppercase"
                                    style="font-size: 0.65rem;">Estafetas</small>
                                <div class="h4 mb-0">
                                    <%= stats.totalEstafetas %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card card-body bg-white border">
                                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.65rem;">Mercados
                                    Pendentes</small>
                                <div class="h4 mb-0">
                                    <%= stats.pendentes %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card card-body bg-white border">
                                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.65rem;">Mercados
                                    Ativos</small>
                                <div class="h4 mb-0">
                                    <%= stats.ativos %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card card-body bg-white border">
                                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.65rem;">Mercados Bloqueados</small>
                                <div class="h4 mb-0">
                                    <%= stats.bloqueados %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card card-body bg-white border">
                                <small class="text-muted fw-bold text-uppercase"
                                    style="font-size: 0.65rem;">Produtos</small>
                                <div class="h4 mb-0">
                                    <%= stats.totalProdutos %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card card-body bg-white border">
                                <small class="text-muted fw-bold text-uppercase"
                                    style="font-size: 0.65rem;">Encomendas</small>
                                <div class="h4 mb-0">
                                    <%= stats.totalEncomendas %>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card card-body bg-white border">
                                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.65rem;">Total
                                    Faturado</small>
                                <div class="h4 mb-0">
                                    <%= stats.valorTotal %>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </main>


</body>

</html>
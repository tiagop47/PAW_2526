<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('../partials/head') %>
</head>

<body class="bg-white">

    <%- include('../partials/navbar') %>

    <main class="container py-4">
        <h1 class="h3 border-bottom pb-2 mb-4">Administração</h1>

        <div class="row g-2 mb-4">
            <div class="col-md-4"><a href="/admin/supermercados/pendentes" class="btn btn-secondary w-100 py-3">Aprovações</a></div>
            <div class="col-md-4"><a href="/admin/exibirUtilizadores" class="btn btn-secondary w-100 py-3">Utilizadores</a></div>
            <div class="col-md-4"><a href="/admin/estafetas" class="btn btn-secondary w-100 py-3">Estafetas</a></div>
        </div>

        <div class="row g-3 mb-5">
            <div class="col-md-6">
                <div class="border rounded p-3 bg-light h-100">
                    <div class="text-muted small text-uppercase">Total de Utilizadores</div>
                    <div class="h3 fw-bold mb-0"><%= totalUsers %></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="border rounded p-3 bg-light h-100">
                    <div class="text-muted small text-uppercase">Supermercados Pendentes</div>
                    <div class="h3 fw-bold mb-0"><%= pendentes %></div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Supermercados Ativos</h5>
            <div class="d-flex align-items-center gap-2">
                <button id="btn-ant" class="btn btn-sm btn-secondary" disabled>Anterior</button>
                <span id="info-pagina" class="text-muted small fw-bold"></span>
                <button id="btn-prox" class="btn btn-sm btn-secondary">Próximo</button>
            </div>
        </div>

        <div class="border">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Nome</th>
                        <th>Localização</th>
                        <th class="text-end pe-3">Ação</th>
                    </tr>
                </thead>
                <tbody id="corpo-tabela">
                    <tr><td colspan="3" class="text-center py-4 text-muted">A carregar...</td></tr>
                </tbody>
            </table>
        </div>
    </main>

    <script src="/javascript/adminActions.js"></script>
</body>

</html>

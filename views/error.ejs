<!DOCTYPE html>
<html lang="pt">

<head>
    <%- include('./partials/head', { title: 'Erro' }) %>
</head>

<body class="bg-light">

    <%- include('./partials/navbar') %>

        <% const statusCode = locals.error?.status || 500; %>
        <% const tituloErro = statusCode === 404
            ? 'Página não encontrada'
            : statusCode === 500
                ? 'Página em construção'
                : 'Algo correu mal'; %>
        <% const detalheErro = statusCode === 404
            ? 'A página que procuras não existe ou foi movida.'
            : statusCode === 500
                ? 'Estamos a construir esta área.'
                : (message || 'Ocorreu um erro inesperado.'); %>

                    <div class="container mt-5">
                        <div class="cartao-autenticacao text-center mx-auto">
                            <h1 class="display-1 text-danger fw-bold">
                                <%= statusCode %>
                            </h1>
                            <h2 class="h4 mb-4">
                                <%= tituloErro %>
                            </h2>
                            <p class="text-muted mb-4">
                                <%= detalheErro %>
                            </p>
                        </div>
                    </div>

</body>

</html>